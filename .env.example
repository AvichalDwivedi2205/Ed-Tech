# Google AI API
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Perplexity API
# Get your API key from https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Clerk Authentication (for backend verification)
# Get your secret key from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Convex Backend URL (optional, for backend integration)
CONVEX_URL=https://your-deployment.convex.cloud

# Tavily Search API (Optional)
# Get your API key from https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Backend Configuration (Optional)
# Port for the FastAPI server
PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3017

# Environment
ENVIRONMENT=development
